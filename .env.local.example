# ── Stripe (Zahlungen) ──────────────────────────────────────────────
# Secret Key aus dem Stripe-Dashboard (Test: sk_test_..., Live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Publishable Key (Test: pk_test_..., Live: pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook Signing Secret (Dashboard → Developers → Webhooks): whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Resend (Kontaktformular-Versand) ────────────────────────────────
RESEND_API_KEY=re_xxx
# Empfänger (dein IONOS-Postfach)
CONTACT_TO=info@lumorani.com
# Absender – muss eine in Resend verifizierte Domain sein, sonst onboarding@resend.dev
CONTACT_FROM=LUMORANI <kontakt@lumorani.com>

# ── Newsletter (Double-Opt-in) ──────────────────────────────────────
# Geheimer HMAC-Schlüssel zum Signieren der Bestätigungs-Links.
# Generieren: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEWSLETTER_SIGNING_SECRET=change_me

# ── Allgemein ───────────────────────────────────────────────────────
# Lokal: http://localhost:3000 · Produktion: die feste öffentliche Shop-URL (https://…)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
