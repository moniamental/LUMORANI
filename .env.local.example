# ── Stripe (Zahlungen) ──────────────────────────────────────────────
# Secret Key aus dem Stripe-Dashboard (Test: sk_test_..., Live: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook Signing Secret (Dashboard → Developers → Webhooks): whsec_...
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Resend (Kontaktformular-Versand) ────────────────────────────────
RESEND_API_KEY=re_xxx
# Empfänger (dein IONOS-Postfach)
CONTACT_TO=info@lumorani.com
# Absender – muss eine in Resend verifizierte Domain sein, sonst onboarding@resend.dev
CONTACT_FROM=LUMORANI <kontakt@lumorani.com>

# ── Allgemein ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
